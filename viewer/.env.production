# 公開時のタイル配信元。R2（バケット shi-works）を Cloudflare Worker が
# shi-works.com で配る。キー設計は shiwaku/xserver-cleanup の R2-STRUCTURE.md に従う。
VITE_TILES_BASE=https://shi-works.com/raster-tiles/pref-shizuoka
# terrarium / Terrain-RGB は WebP で配る（dem2tiles の TILE_FORMAT 既定）。
# 中身は PNG と画素単位で同一。数値PNG（gsidem）は常に PNG なので対象外。
VITE_TILES_EXT=webp
