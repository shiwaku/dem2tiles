{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dem2tiles-tiles",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Mapterhorn の tiles.mapterhorn.com に倣い、配信用のサブドメインを Worker に割り当てる。
  // shi-works.com 本体は R2 のカスタムドメインのまま触らない
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tiles.shi-works.com", "custom_domain": true }],

  // 共有バケット shi-works。PMTiles は pmtiles/{県}/{名前}.pmtiles に置く（R2-STRUCTURE.md §4）
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "shi-works" }]
}
